<UserControl x:Class="PSLauncher.Views.ObjectResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PSLauncher.Views"
             xmlns:model="clr-namespace:PSLauncher.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=model:ResultList}"
             d:DesignHeight="100" d:DesignWidth="800">
    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
            <Label Content="_Result:"/>
            <TextBlock Text="{Binding Description,FallbackValue=&lt;none&gt;}" Padding="5,0,0,0"/>
        </StackPanel>
        <DockPanel>
            <TextBox Name="ResultText"
                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     MaxHeight="200"
                     FontFamily="Consolas"
                     Text="{Binding DisplayData, Mode=OneWay, FallbackValue=&lt;none&gt;}"
                     />
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDisplayData}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
        </DockPanel>
        <Expander x:Name="DetailExpander" Header="_Detail:"
            IsExpanded="True" MaxHeight="600" Style="{StaticResource CompactExpanderStyle}">
            <DataGrid x:Name="ResultGrid"
                      MaxHeight="600"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      VerticalScrollBarVisibility="Auto"
                      HeadersVisibility="Column"
                      ContextMenuOpening="ResultGridCell_ContextMenuOpening"
                      GotFocus="ResultGrid_GotFocus"
                      PreviewKeyDown="ResultData_RowKeyDown"
                      ItemsSource="{Binding Items}"
                      >
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="auto" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel Margin="{Binding Level, Converter={StaticResource IndentConverter}}" VerticalAlignment="Top" >
                                    <ToggleButton IsChecked="{Binding IsExpaned}" Style="{StaticResource ExpandToggleStyle}"
                                                      Click="ResultData_Click"/>
                                    <TextBlock Text="{Binding Name}" TextWrapping="WrapWithOverflow"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <DockPanel Margin="{Binding Level, Converter={StaticResource IndentConverter}}">
                                    <Border Width="16"/>
                                    <TextBox Text="{Binding Name, Mode=OneTime}"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Value" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" MaxHeight="35"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding RawValue, Mode=OneTime}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Expander>
    </StackPanel>
</UserControl>
