<UserControl x:Class="PSLauncher.Views.FileSystemResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PSLauncher.Views"
             xmlns:model="clr-namespace:PSLauncher.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=model:ResultList}"
             d:DesignHeight="100" d:DesignWidth="800">
    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
            <Label Content="_Result:"/>
            <TextBlock Text="{Binding Description, FallbackValue=&lt;none&gt;}" Padding="5,0,0,0"/>
        </StackPanel>
        <Expander x:Name="DetailExpander" Header="_Detail:"
                  IsExpanded="True" MaxHeight="600" Style="{StaticResource CompactExpanderStyle}">
            <DataGrid x:Name="ResultGrid"
                      MaxHeight="600"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      VerticalScrollBarVisibility="Auto"
                      HeadersVisibility="Column"
                      GotFocus="ResultGrid_GotFocus"
                      PreviewKeyDown="ResultData_RowKeyDown"
                      ItemsSource="{Binding Items}"
                      >
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="local:ResultDataRow">
                                <DockPanel Margin="{Binding Level, Converter={StaticResource IndentConverter}}" VerticalAlignment="Top" >
                                    <ToggleButton IsChecked="{Binding IsExpaned}" Style="{StaticResource ExpandToggleStyle}"
                                                  Click="ResultData_Click"/>
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="2,0,2,0"/>
                                    <TextBlock Text="{Binding Name}" TextWrapping="WrapWithOverflow"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate DataType="local:ResultDataRow">
                                <DockPanel Margin="{Binding Level, Converter={StaticResource IndentConverter}}">
                                    <Border Width="16"/>
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="2,0,2,0"/>
                                    <TextBox Text="{Binding Name, Mode=OneTime}"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Last Modified" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastWriteTime, StringFormat='yyyy/MM/dd HH:mm:ss'}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat='N0'}" Width="Auto" TextBlock.TextAlignment="Right"/>
                </DataGrid.Columns>
            </DataGrid>
        </Expander>
    </StackPanel>
</UserControl>
