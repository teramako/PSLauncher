<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:PSLauncher"
                    xmlns:converters="clr-namespace:PSLauncher.Converters">

    <converters:IndentConverter x:Key="IndentConverter"/>

    <!-- Expand Button Style in DataGrid -->
    <Style x:Key="ExpandToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Visibility" Value="Hidden"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="16" Height="16">
                        <ContentPresenter/>
                        <Path x:Name="Arrow" Fill="Gray" Data="M 6,4 L 6,12 L 10,8 Z"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="Data" Value="M 4,6 L 12,6 L 8,10 Z"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasChildren}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Compact Expander Style -->
    <Style x:Key="CompactExpanderStyle" TargetType="Expander" BasedOn="{StaticResource DefaultExpanderStyle}">
        <Setter Property="Padding" Value="0,3,0,3"/>
    </Style>

    <!-- DataGrid Style -->
    <Style TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
        <Setter Property="MinHeight" Value=""/>
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
        <Setter Property="MinHeight" Value=""/>
    </Style>


    <Style x:Key="TypeTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Padding" Value="5,0,5,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>