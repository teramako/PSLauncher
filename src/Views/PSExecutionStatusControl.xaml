<UserControl x:Class="PSLauncher.Views.PSExecutionStatusControl"
             Name="streams"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PSLauncher.Views"
             xmlns:model="clr-namespace:PSLauncher.Models"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="PopupBroderStyle" TargetType="Border">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style x:Key="StreamStatusBarItemStyle" TargetType="StatusBarItem">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Grid d:DataContext="{d:DesignInstance Type=model:ResultList}">
                            <ToggleButton Name="PopupButton">
                                <AccessText>
                                    <AccessText.Text>
                                        <MultiBinding StringFormat="{}_{0}: {1:N0}">
                                            <Binding Path="Description" Mode="OneTime"/>
                                            <Binding Path="Count" Mode="OneWay"/>
                                        </MultiBinding>
                                    </AccessText.Text>
                                </AccessText>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=PopupButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Path Grid.Row="0" Data="M20,10 L30,0 L40,10 Z" Fill="{TemplateBinding Background}"/>
                                    <Border Grid.Row="1" Background="{TemplateBinding Background}" Style="{StaticResource PopupBroderStyle}">
                                        <local:ObjectGridDataView DataContext="{Binding}" MaxWidth="800"/>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Count, FallbackValue=0}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal">
        <StatusBarItem Name="ErrorStatus" DataContext="{Binding ErrorList, ElementName=streams}"
                       Style="{StaticResource StreamStatusBarItemStyle}"
                       Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
        <StatusBarItem Name="WarningStatus" DataContext="{Binding WarningList, ElementName=streams}"
                       Style="{StaticResource StreamStatusBarItemStyle}"
                       Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
        <StatusBarItem Name="VerboseStatus" DataContext="{Binding VerboseList, ElementName=streams}"
                       Style="{StaticResource StreamStatusBarItemStyle}"
                       Background="{DynamicResource SystemFillColorSolidAttentionBackgroundBrush}"/>
        <StatusBarItem Name="InformationStatus" DataContext="{Binding InformationList, ElementName=streams}"
                       Style="{StaticResource StreamStatusBarItemStyle}"
                       Background="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}"/>
        <StatusBarItem Name="DebugStatus" DataContext="{Binding DebugList, ElementName=streams}"
                       Style="{StaticResource StreamStatusBarItemStyle}"
                       Background="{DynamicResource SystemFillColorSolidAttentionBackgroundBrush}"/>
    </StackPanel>
</UserControl>
