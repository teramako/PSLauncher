<UserControl x:Class="PSLauncher.Views.ResultViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PSLauncher.Views"
             xmlns:model="clr-namespace:PSLauncher.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=model:ResultList}"
             d:DesignHeight="100" d:DesignWidth="800">
    <StackPanel Style="{StaticResource ResultStackPanelStyle}"
                d:DataContext="{d:DesignInstance Type=model:ResultList}">
        <StackPanel Orientation="Horizontal">
            <Label Content="_Result:"/>
            <TextBlock Text="{Binding Description,FallbackValue=&lt;none&gt;}" Padding="5,0,0,0"/>
        </StackPanel>
        <TextBox Name="ResultText" Style="{StaticResource ResultTextBoxStyle}"
                 Text="{Binding DisplayData, Mode=OneWay, FallbackValue=&lt;none&gt;}"
                 IsEnabled="{Binding HasDisplayData}"/>
        <Expander x:Name="DetailExpander" Style="{StaticResource ResultExpanderStyle}"
                  Header="_Detail:"
                  MaxHeight="600">
            <local:ExpandableDataGridControl x:Name="DetailDataGrid" DataContext="{Binding}"/>
        </Expander>
    </StackPanel>
</UserControl>
