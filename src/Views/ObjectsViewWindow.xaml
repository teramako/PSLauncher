<Window x:Class="PSLauncher.Views.ObjectsViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:main="clr-namespace:PSLauncher"
        xmlns:view="clr-namespace:PSLauncher.Views"
        xmlns:model="clr-namespace:PSLauncher.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=model:ResultList}"
        Title="Objects View"
        Height="450" Width="600"
        MaxHeight="800"
        ThemeMode="Dark"
        SizeToContent="Height">
    <DockPanel Margin="5">
        <view:ExpandableDataGridControl x:Name="DetailDataGrid" DataContext="{Binding}"/>
    </DockPanel>
</Window>
