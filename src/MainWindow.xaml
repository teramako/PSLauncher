<Window x:Name="window" x:Class="PSLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PSLauncher"
        xmlns:view="clr-namespace:PSLauncher.Views"
        xmlns:model="clr-namespace:PSLauncher.Models"
        mc:Ignorable="d"
        Title="PSLauncher"
        MaxWidth="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        MouseDown="Window_MouseDown"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        ThemeMode="Dark"
        >
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/MainWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.Close" Key="F4" Modifiers="Alt"/>
        <KeyBinding Command="local:Commands.FocusToResultContent" Key="R" Modifiers="Alt"/>
        <KeyBinding Command="local:Commands.UnpinItem" Key="P" Modifiers="Ctrl+Shift"/>
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="ExitApplication"/>
        <CommandBinding Command="local:Commands.FocusToResultContent" Executed="FocusToResultContent"/>
        <CommandBinding Command="local:Commands.StopExecution" Executed="StopExcution" CanExecute="CanStopExecution"/>
        <CommandBinding Command="local:Commands.PinItem" Executed="PinItem" CanExecute="CanPinItem"/>
        <CommandBinding Command="local:Commands.UnpinItem" Executed="UnpinItem" CanExecute="CanUnpinItem"/>
    </Window.CommandBindings>

    <Border Style="{StaticResource WindowBorderStyle}">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto">
            <Grid Grid.Row="0" ColumnDefinitions="40, *">
                <Grid Grid.Column="0">
                    <Image Style="{StaticResource PSLauncherImageStyle}"/>
                    <Label Content="_C" Target="{Binding ElementName=CommandBox}" Opacity="0" IsTabStop="False" Focusable="False"/>
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="ApplicationCommands.Close"/>
                        </ContextMenu>
                    </Grid.ContextMenu>
                </Grid>
                <RichTextBox x:Name="CommandBox" Grid.Column="1" Style="{StaticResource CommandBoxStyle}"
                             Background="#333"
                             InputMethod.PreferredImeState="Off"
                             PreviewKeyDown="CommandBox_PreviewKeyDown"
                             TextChanged="CommandBox_TextChanged"/>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="Auto, *">
                <Label Grid.Column="0" Content="_Location:" Target="{Binding ElementName=LocationBox}" VerticalAlignment="Center"/>
                <ComboBox x:Name="LocationBox" Grid.Column="1"
                          IsEditable="True" IsReadOnly="False"
                          PreviewKeyDown="LocationBox_PreviewKeyDown"
                          PreviewMouseLeftButtonUp="LocationBox_PreviewMouseLeftButtonUp"/>
            </Grid>

            <view:ResultViewControl x:Name="ResultContent" Grid.Row="2" Focusable="False"/>
            <StatusBar Grid.Row="3" Padding="2">
                <view:PSExecutionStatusControl x:Name="ExecutionStatus"/>
                <Separator/>
                <view:PSStreamStatusControl x:Name="StreamStatusPanel"/>
                <StatusBarItem x:Name="PinnedItem" d:DataContext="{d:DesignInstance Type=model:PinnedItem}"
                               Style="{StaticResource PinnedStatusBarItemStyle}"
                               ToolTip="{Binding ToolTipText}"
                               ContextMenu="{StaticResource PinnedItemContextMenu}">
                    <ToggleButton Name="PinnedButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16">
                                <Path Data="{StaticResource PinnedPath}" Stretch="Uniform" Fill="{StaticResource PinnedIconColorBrush}"/>
                                <AccessText Text="_P" Foreground="Transparent"/>
                            </Grid>
                            <Image Source="{Binding Icon}" Style="{StaticResource ItemIconStyle}"/>
                            <TextBlock Text="{Binding Description}" Padding="4,0,0,0"/>
                            <Popup IsOpen="{Binding IsChecked, ElementName=PinnedButton}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" MaxWidth="600"
                                   Opened="PinnedItem_OnPopupOpened">
                                <ContentControl Name="PopupContent" Template="{StaticResource BottomBalloonTemplate}"
                                                Background="{StaticResource DefaultBalloonPopupBackgroundColorBrush}">
                                    <StackPanel Orientation="Vertical">
                                        <TextBox Name="ResultText" Style="{StaticResource ResultTextBoxStyle}"
                                                 Text="{Binding DisplayData, Mode=OneWay}"
                                                 IsEnabled="{Binding HasDisplayData}"/>
                                        <view:ExpandableDataGridControl x:Name="DetailDataGrid" DataContext="{Binding}" MaxHeight="200"/>
                                    </StackPanel>
                                </ContentControl>
                            </Popup>
                        </StackPanel>
                    </ToggleButton>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Border>
</Window>
