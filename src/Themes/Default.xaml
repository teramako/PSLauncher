<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:PSLauncher"
                    xmlns:converters="clr-namespace:PSLauncher.Converters">

    <converters:IndentConverter x:Key="IndentConverter"/>

    <!-- Expand Button Style in DataGrid -->
    <Style x:Key="ExpandToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Visibility" Value="Hidden"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="16" Height="16">
                        <ContentPresenter/>
                        <Path x:Name="Arrow" Fill="Gray" Data="M 6,4 L 6,12 L 10,8 Z"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="Data" Value="M 4,6 L 12,6 L 8,10 Z"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasChildren}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Compact Expander Style -->
    <Style x:Key="CompactExpanderStyle" TargetType="Expander" BasedOn="{StaticResource DefaultExpanderStyle}">
        <Setter Property="Padding" Value="0,3,0,3"/>
    </Style>

    <!-- DataGrid Style -->
    <Style TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
        <Setter Property="MinHeight" Value=""/>
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
        <Setter Property="MinHeight" Value=""/>
    </Style>


    <Style x:Key="TypeTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Padding" Value="5,0,5,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Balloon Popup Template -->
    <Style x:Key="BalloonPopupBroderStyle" TargetType="Border">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <ControlTemplate x:Key="BottomBalloonTemplate" TargetType="ContentControl">
        <Grid RowDefinitions="10, Auto">
            <Path Grid.Row="0" Data="M20,10 L30,0 L40,10 Z" Fill="{TemplateBinding Background}"/>
            <Border Grid.Row="1" Background="{TemplateBinding Background}" Style="{StaticResource BalloonPopupBroderStyle}">
                <ContentPresenter/>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- ResultView -->
    <Style x:Key="ResultStackPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Vertical"/>
        <Style.Triggers>
            <Trigger Property="DataContext" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ResultTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="MaxHeight" Value="200"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ResultExpanderStyle" TargetType="Expander" BasedOn="{StaticResource DefaultExpanderStyle}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="IsExpanded" Value="True"/>
        <Setter Property="Padding" Value="0,3,0,3"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Complex">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Files">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
